#!/bin/sh
# Copy the NES and SNES ROMs (and RetroPie's old .srm saves beside them) from
# brick2000's /extra/games/roms, then rewrite RetroArch's playlists. Run daily
# by brick-roms.timer, or now with: systemctl --user start brick-roms.service
#
# brick2000 only lets this key read /extra/games/roms (rrsync -ro; install.sh
# prints the authorized_keys line). A local copy keeps games playable when
# brick2000 or the cluster is down.
set -eu
src=${BRICK_ROMS_SOURCE:-zaphod@brick2000}
dest=${BRICK_RETRO_ROM_DIR:-$HOME/games/roms}
for system in nes snes; do
    mkdir -p "$dest/$system"
    rsync -rt --delete --prune-empty-dirs \
        -e "ssh -i $HOME/.ssh/brick-roms -o BatchMode=yes" \
        --include='*/' --include='*.[nN][eE][sS]' --include='*.[sS][mM][cC]' \
        --include='*.[sS][fF][cC]' --include='*.[zZ][iI][pP]' --include='*.srm' \
        --exclude='*' "$src:$system/" "$dest/$system/"
done
cd "$(dirname "$0")/../brick-retro"
exec python3 -m brick_retro games
