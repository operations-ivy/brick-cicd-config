#!/bin/sh
# Copy the ROMs (and RetroPie's old .srm saves beside them) and the BIOS files
# the cores use from brick2000's /extra/games, then rewrite RetroArch's
# playlists. Run daily by brick-roms.timer, or now with:
# systemctl --user start brick-roms.service
#
# brick2000 only lets this key read /extra/games (rrsync -ro; install.sh
# prints the authorized_keys line). A local copy keeps games playable when
# brick2000 or the cluster is down.
# -f: the --include patterns below are for rsync, never the shell's globs.
set -euf
src=${BRICK_ROMS_SOURCE:-zaphod@brick2000}
dest=${BRICK_RETRO_ROM_DIR:-$HOME/games/roms}
system_dir=${BRICK_RETRO_SYSTEM_DIR:-$HOME/games/system}
ssh="ssh -i $HOME/.ssh/brick-roms -o BatchMode=yes"

# --include=*.[nN][eE][sS] for each extension given (none has a space).
includes() {
    printf '%s\n' "$@" | awk '{
        s = "--include=*."
        for (i = 1; i <= length($0); i++) { c = substr($0, i, 1); s = s "[" c toupper(c) "]" }
        print s
    }'
}

playlists() {
    (cd "$(dirname "$0")/../brick-retro" && python3 -m brick_retro games)
}

sync() {
    system=$1
    shift
    mkdir -p "$dest/$system"
    # psx/PS1 on brick2000 is a second copy of the .chd games beside it.
    rsync -rt --delete --prune-empty-dirs -e "$ssh" \
        --exclude=/PS1/ --include='*/' $(includes "$@" srm) --exclude='*' \
        "$src:roms/$system/" "$dest/$system/"
}

sync nes nes zip
sync snes smc sfc zip
sync gb gb zip
sync gbc gbc zip
sync gba gba zip
sync megadrive md gen smd bin zip
sync mastersystem sms zip
# BIOS files: PlayStation (needed), Game Boy family and Sega (optional, used
# when a core's option asks for them).
mkdir -p "$system_dir"
rsync -t -e "$ssh" \
    --include=scph5500.bin --include=scph5501.bin --include=scph5502.bin \
    --include=gb_bios.bin --include=gbc_bios.bin --include=gba_bios.bin \
    --include=bios_U.sms --include=bios_E.sms --include=bios_MD.bin --exclude='*' \
    "$src:BIOS/system/" "$system_dir/"

# The cartridge games are small; list them now rather than after the CD
# images, whose first copy takes hours.
playlists
# CD images; .ecm and .7z need unpacking first, so they stay on brick2000.
sync psx chd cue ccd img sub bin pbp
playlists
