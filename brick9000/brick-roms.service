# systemd user unit: installed to ~/.config/systemd/user/ by install.sh.
[Unit]
Description=Copy ROMs and BIOS files from brick2000 and rewrite the playlists
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/brick-retro/env
ExecStart=%h/brick-cicd-config/brick9000/sync-roms
# How the run went, for Prometheus (brick_status/jobs.py); '-': never fails the run.
ExecStopPost=-/usr/bin/env PYTHONPATH=%h/brick-cicd-config/brick-status python3 -m brick_status.jobs brick-roms
