#!/bin/sh
# Reapply casc.yaml and rerun seed.groovy in the running Jenkins, e.g. after a
# job definition changed. Run by deploy.
set -eu
token=$(cat "$HOME/.config/brick-jenkins/secrets/casc_reload_token")
curl -fsS -X POST -o /dev/null "http://127.0.0.1:8080/reload-configuration-as-code/?casc-reload-token=$token"
