#!/bin/sh
# Build the Jenkins image if anything in it changed, and (re)start the
# container. Run by install.sh, and by deploy when the image's files change.
# A failed build leaves the running container alone. Like build-image, it
# shows on the button lights: rainbow while building, then green or red.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
CASC_RELOAD_TOKEN=$(cat "$HOME/.config/brick-jenkins/secrets/casc_reload_token")
DOCKER_GID=$(getent group docker | cut -d: -f3)
export CASC_RELOAD_TOKEN DOCKER_GID

image=brick-jenkins:local
ref=$(git -C "$here" rev-parse --short HEAD 2>/dev/null || echo unknown)
. "$here/../build-status.sh"
result=failed
trap 'write_status "$result" "$(date +%s)"; echo "jenkins/up: $image $result"' EXIT
trap 'exit 1' HUP INT TERM
write_status building

docker compose -f "$here/compose.yaml" build
docker compose -f "$here/compose.yaml" up -d "$@"
result=succeeded
