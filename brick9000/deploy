#!/bin/sh
# Deploy brick-status from GitHub. Run every 2 hours by brick-deploy.timer,
# or now with: systemctl --user start brick-deploy.service
#
# If the branch brick9000 follows (BRICK_DEPLOY_BRANCH in the env file, main
# by default) has moved, test the new commit in a scratch worktree and switch
# to it only if the tests pass, then restart brick-status. A commit that fails
# is remembered and not retried until the branch moves again.
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
env_file=$HOME/.config/brick-status/env
state=${XDG_STATE_HOME:-$HOME/.local/state}/brick-deploy
mkdir -p "$state"

branch=$(sed -n 's/^BRICK_DEPLOY_BRANCH=//p' "$env_file" 2>/dev/null | tail -n 1)
branch=${branch:-main}

cd "$repo"
git fetch --quiet --prune origin
if ! target=$(git rev-parse --verify --quiet "origin/$branch^{commit}"); then
    echo "deploy: no branch '$branch' on GitHub; staying on $(git rev-parse --short HEAD)" >&2
    exit 1
fi
current=$(git rev-parse HEAD)
[ "$target" != "$current" ] || exit 0
[ "$target" != "$(cat "$state/failed" 2>/dev/null)" ] || exit 0

# From here brick9000 is rebuilding itself: the buttons boil until it's done,
# then flash green or pulse red (brick-status/brick_status/build.py).
image=brick9000 ref=$(git rev-parse --short "$target") status_name=deploy
. "$repo/brick9000/build-status.sh"
result=failed
scratch=$(mktemp -d)
finish() {
    git worktree remove --force "$scratch/tree" 2>/dev/null || true
    rm -rf "$scratch"
    write_status "$result" "$(date +%s)"
}
trap finish EXIT
trap 'exit 1' HUP INT TERM
write_status building
git worktree add --quiet --detach "$scratch/tree" "$target"
if ! "$scratch/tree/scripts/test" >"$scratch/log" 2>&1; then
    cat "$scratch/log" >&2
    echo "$target" >"$state/failed"
    echo "deploy: tests failed on $branch @ $(git rev-parse --short "$target"); staying on $(git rev-parse --short "$current")" >&2
    exit 1
fi

git checkout --quiet --force --detach "$target"
rm -f "$state/failed"
changed() { ! git diff --quiet "$current" "$target" -- "$@"; }
# Jenkins reads its config, jobs and scripts from this clone. A changed image
# needs a rebuild (a failed one leaves Jenkins running as it was); changed
# config or job definitions need a reload; changed scripts need nothing.
if changed brick9000/jenkins/Dockerfile brick9000/jenkins/plugins.txt brick9000/jenkins/compose.yaml; then
    brick9000/jenkins/up || echo "deploy: Jenkins image rebuild failed; still running the old one" >&2
elif changed brick9000/jenkins/casc.yaml brick9000/jenkins/seed.groovy brick9000/jenkins/jobs; then
    brick9000/jenkins/reload || echo "deploy: Jenkins config reload failed" >&2
fi
if changed brick9000/proxy; then
    brick9000/proxy/up || echo "deploy: proxy update failed" >&2
fi
if changed brick9000/ ':!brick9000/jenkins' ':!brick9000/proxy'; then
    echo "deploy: brick9000/ changed; run brick9000/install.sh to apply it" >&2
fi
result=succeeded
systemctl --user restart brick-status
echo "deploy: $branch @ $(git rev-parse --short HEAD) (was $(git rev-parse --short "$current"))"
