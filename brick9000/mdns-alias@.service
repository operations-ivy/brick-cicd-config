[Unit]
Description=Announce %i.local (a name for brick9000) over mDNS
After=network-online.target

[Service]
# The user manager can't wait for the system's network-online.target, so wait
# here for brick9000's LAN address (the source of its route to the router;
# works with the internet down). Started too early, `hostname -I` was empty and
# the name was published as 0.0.0.0.
# -R: no reverse record; the address already reverse-resolves to brick9000.local.
ExecStart=/bin/sh -c 'until ip=$(ip -4 route get 192.168.1.1 2>/dev/null | sed -n "s/.* src \\([0-9.]*\\).*/\\1/p") && [ -n "$ip" ]; do sleep 2; done; exec avahi-publish -a -R %i.local "$ip"'
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
