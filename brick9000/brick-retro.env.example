# Copied to ~/.config/brick-retro/env by install.sh; edit there.
# Where the ROMs come from: brick2000 lets only ~/.ssh/brick-roms read
# /extra/games/roms through it (install.sh prints the line to authorize).
BRICK_ROMS_SOURCE=zaphod@brick2000
# The loudest Home + D-pad up goes, as a fraction of the DAC's full volume
# (the Picade's speaker is very loud); ten notches up to it.
BRICK_RETRO_MAX_VOLUME=0.5
# With no controller connected for this long, RetroArch closes (saving a
# state first) and the board shows again.
BRICK_RETRO_IDLE_EXIT_SECONDS=900
