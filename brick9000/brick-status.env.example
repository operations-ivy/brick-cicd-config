# Copied to ~/.config/brick-status/env by install.sh; edit there.
BRICK_STATUS_PROMETHEUS_URL=http://prometheus.local
# Plasma LED slot for each button: top row left to right, then bottom row.
BRICK_STATUS_BUTTON_SLOTS=2,1,0,3,4,5
BRICK_STATUS_QUIET_START=00:00
BRICK_STATUS_QUIET_END=06:00
BRICK_STATUS_ACTIVE_SECONDS=120
