# Copied to ~/.config/brick-status/env by install.sh; edit there.
BRICK_STATUS_PROMETHEUS_URL=https://prometheus.brick.nozdormu.cloud
# Plasma LED slot for each button: top row left to right, then bottom row.
BRICK_STATUS_BUTTON_SLOTS=2,1,0,3,4,5
# When the screen and lights are off: "HH:MM-HH:MM" daily or "Day HH:MM-Day HH:MM"
# weekly, several separated by ","; entries separated by ";", each optionally
# from a date ("YYYY-MM-DD: ...").
# While off, only the side button does anything: it turns everything on for
# BRICK_STATUS_WAKE_SECONDS.
BRICK_STATUS_QUIET=00:00-06:00; 2026-10-09: Mon 00:01-Mon 16:00, Tue 00:00-Tue 16:00, Wed 00:00-Wed 16:00, Thu 00:00-Thu 16:00, Fri 00:00-Fri 16:00
BRICK_STATUS_WAKE_SECONDS=1800
BRICK_STATUS_ACTIVE_SECONDS=120
# How long the lights show a brick9000/build-image result.
BRICK_STATUS_BUILD_RESULT_SECONDS=60
# Phone pages through ntfy (README, "Alerts"). The topic itself is in
# ~/.config/brick-status/ntfy_topic (install.sh makes it), never here.
BRICK_STATUS_NTFY_URL=https://ntfy.sh
# Where tapping a page goes (opens only on the home network); empty for nowhere.
BRICK_STATUS_NTFY_CLICK=https://status.brick.nozdormu.cloud
# Branch brick9000 deploys from GitHub (brick9000/deploy). Point it at a
# branch to try that on the real board; set it back to main after merging.
BRICK_DEPLOY_BRANCH=main
