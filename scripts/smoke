#!/usr/bin/env python3
"""Post-deploy smoke check: is everything up that the homelab needs?

    scripts/smoke            # from the laptop or Jenkins, read-only

- every *.brick.nozdormu.cloud name answers through the front door (Caddy on
  the cluster at 192.168.1.221 since 2026-10-17)
- the LCARS panel's kiosk on brick1982 is running (over SSH)
- brick9000 (the arcade and the board, no longer anything the homelab
  needs): brick-status running and the board's data fresh. Only a warning
  when it's down: brick9000 is optional since its hardware failed on
  2026-10-17.

Exits 1 if anything the homelab needs is down.
"""

import json
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.request

# name -> the statuses that mean "up" (logins redirect or refuse). status
# redirects to Grafana while brick9000 is away.
NAMES = {"status": {200, 302}, "radar": {200}, "wigle": {200}, "reader": {200}, "overwatch": {200},
         "homeassistant": {200, 302}, "grafana": {200, 302}, "prometheus": {200, 302}, "jenkins": {200, 403},
         "argocd": {200}, "dashboard": {200}}
# host -> (needed by the homelab?, units)
SERVICES = {"brick1982": (True, [("", "lcars-kiosk"), ("--user", "lcars-deploy.timer")]),
            "brick9000": (False, [("--user", "brick-status")])}


def status(url: str) -> int:
    req = urllib.request.Request(url, method="GET")
    try:
        return urllib.request.urlopen(req, timeout=10, context=ssl.create_default_context()).status
    except urllib.error.HTTPError as e:
        return e.code
    except OSError:
        return 0


def ssh(host: str, command: str) -> str:
    out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", f"zaphod@{host}", command],
                         capture_output=True, text=True)
    return out.stdout.strip()


def main() -> int:
    problems, warnings = [], []
    for name, ok in NAMES.items():
        code = status(f"https://{name}.brick.nozdormu.cloud/")
        print(f"{'ok  ' if code in ok else 'DOWN'} {name}.brick.nozdormu.cloud ({code or 'no answer'})")
        if code not in ok:
            problems.append(name)
    for host, (needed, units) in SERVICES.items():
        for scope, unit in units:
            state = ssh(host, f"systemctl {scope} is-active {unit}") or "unreachable"
            mark = "ok  " if state == "active" else ("DOWN" if needed else "warn")
            print(f"{mark} {host} {unit} ({state})")
            if state != "active":
                (problems if needed else warnings).append(f"{host}/{unit}")
    # The board's data: brick-status's own state, read on brick9000 (it only
    # listens on localhost there).
    try:
        age = time.time() - json.loads(ssh("brick9000", "curl -s --max-time 5 http://127.0.0.1:8765/api/state")).get("updated", 0)
    except ValueError:
        age = float("inf")
    print(f"{'ok  ' if age < 60 else 'warn'} brick9000 board data ({'unreachable' if age == float('inf') else f'{age:.0f}s old'})")
    if age >= 60:
        warnings.append("board data")
    if warnings:
        print(f"\nbrick9000 (optional): {', '.join(warnings)}")
    print(f"\n{'all up' if not problems else 'problems: ' + ', '.join(problems)}")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
