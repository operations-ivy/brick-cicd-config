#!/bin/sh
# Run the brick-status and brick-arena unit tests, then the functional tests
# (functional/: the real HTTP server, deploy scripts and Jenkins' deploy
# helper, against stubs). Used by the pre-push hook, open-pr and both deploy
# scripts.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
for pkg in brick-status brick-arena; do
    (cd "$root/$pkg" && python3 -m unittest discover -s tests -t . -v)
done
(cd "$root" && python3 -m unittest discover -s functional -t . -v)
