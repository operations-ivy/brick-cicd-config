#!/usr/bin/env python3
"""Write a cursor theme whose every cursor is one transparent pixel.

cage draws the pointer from the theme named "default" in XCURSOR_PATH, and the
touchscreen counts as a pointer, so without this an arrow sits on the panel.
brick-kiosk.service points XCURSOR_PATH at the directory this writes into:

    blank-cursors /usr/local/share/brick-arena/cursors/default
"""

import struct
import sys
from pathlib import Path

# The names compositors and Chromium ask for; any other falls back to default.
NAMES = ["default", "left_ptr", "pointer", "hand2", "text", "xterm", "crosshair", "wait", "watch",
         "progress", "grab", "grabbing", "move", "not-allowed", "help", "context-menu"]


def xcursor() -> bytes:
    """The Xcursor file format: a header, one table-of-contents entry, and one
    1x1 image chunk whose single ARGB pixel is fully transparent."""
    image_type, size = 0xFFFD0002, 1
    header = struct.pack("<4sIII", b"Xcur", 16, 0x10000, 1)
    toc = struct.pack("<III", image_type, size, 16 + 12)
    chunk = struct.pack("<IIIIIIIII", 36, image_type, size, 1, 1, 1, 0, 0, 0) + struct.pack("<I", 0)
    return header + toc + chunk


def main() -> None:
    theme = Path(sys.argv[1])
    cursors = theme / "cursors"
    cursors.mkdir(parents=True, exist_ok=True)
    (theme / "index.theme").write_text("[Icon Theme]\nName=brick-blank\n")
    data = xcursor()
    for name in NAMES:
        (cursors / name).write_bytes(data)


if __name__ == "__main__":
    main()
