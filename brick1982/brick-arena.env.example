# Copied to ~/.config/brick-arena/env by install.sh; edit there.
BRICK_ARENA_PROMETHEUS_URL=https://prometheus.brick.nozdormu.cloud
# Seconds on each view before moving to the next (a tap also moves on).
BRICK_ARENA_ROTATE_SECONDS=45
# When the panel dims ("HH:MM-HH:MM", may wrap past midnight; empty for never),
# and the brightness then and otherwise, as a fraction of full.
BRICK_ARENA_DIM=23:00-07:00
BRICK_ARENA_DIM_LEVEL=0.08
BRICK_ARENA_DAY_LEVEL=1.0
# When the panel is off: brick9000's BRICK_STATUS_QUIET format and, unset,
# brick9000's default (off Monday to Friday until 16:00, on all weekend).
# Keep it the same as BRICK_STATUS_QUIET on brick9000.
#BRICK_ARENA_QUIET=
# How long a tap keeps the panel on during quiet hours (from the last tap).
BRICK_ARENA_WAKE_SECONDS=1800
# Sentry: watch Bluetooth for trackers and gadgets ("on" or "off"), and how
# long it learns the house's normal before alerting (seconds, after each start).
BRICK_ARENA_SENTRY=on
BRICK_ARENA_SENTRY_LEARN_SECONDS=600
# Branch brick1982 deploys from GitHub (brick1982/deploy). Point it at a
# branch to try that on the real screen; set it back to main after merging.
BRICK_DEPLOY_BRANCH=main
