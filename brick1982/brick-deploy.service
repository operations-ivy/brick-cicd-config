# systemd user unit: installed to ~/.config/systemd/user/ by install.sh.
[Unit]
Description=Deploy brick-arena from GitHub
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/brick-cicd-config/brick1982/deploy
# How the run went, for Prometheus (brick_status/jobs.py); '-': never fails the run.
ExecStopPost=-/usr/bin/env PYTHONPATH=%h/brick-cicd-config/brick-status python3 -m brick_status.jobs brick-deploy --git %h/brick-cicd-config
