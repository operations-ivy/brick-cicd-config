#!/bin/sh
# Point brick9000's deploy at BRANCH (empty: main) and start it now, instead
# of at its 2-hourly timer. A deploy with tests and an image rebuild can take
# a while, so only queue it; its result is in brick9000's journal and on its
# buttons, not in this build's log. The timer keeps following the branch.
set -eu
. "$(dirname "$0")/lib.sh"
start_deploy "$BRICK9000" .config/brick-status/env "${BRANCH:-}"
