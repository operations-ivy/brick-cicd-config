#!/usr/bin/env python3
"""Post-deploy smoke check: is everything up that the homelab needs?

    scripts/smoke            # from the laptop, read-only (a link to jenkins/bin/smoke)
    /usr/share/brick-jenkins/bin/smoke   # in Jenkins (the check-all job)

- every *.brick.nozdormu.cloud name answers through the front door (Caddy on
  the cluster at 192.168.1.221 since 2026-10-17)
- the LCARS panel's kiosk on brick1982 is running (over SSH, through jenkins-gate)
- a host in a maintenance window (the maintenance-window job) is still
  checked, but shows "mnt" and doesn't fail the run (the user, 2026-11-05)
- brick9000 (the arcade and the board, no longer anything the homelab
  needs): brick-status running and the board's data fresh. Only a warning
  when it's down: brick9000 is optional since its hardware failed on
  2026-10-17.

Exits 1 if anything the homelab needs is down.
"""

import json
import os
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# name -> the statuses that mean "up" (logins redirect or refuse). status
# redirects to Grafana while brick9000 is away.
NAMES = {"status": {200, 302}, "radar": {200}, "wigle": {200}, "reader": {200}, "overwatch": {200}, "presto": {200},
         "homeassistant": {200, 302}, "grafana": {200, 302}, "prometheus": {200, 302}, "jenkins": {200, 403},
         "argocd": {200}, "dashboard": {200}, "games": {200}}
PROMETHEUS = os.environ.get("PROMETHEUS_URL", "http://kube-prometheus-stack-prometheus.monitoring.svc.cluster.local:9090")
# host -> (needed by the homelab?, the sets of units that each mean it's up).
# brick1982 runs one of two panels (brick-panel's panel-select): the neon one
# or LCARS, either is fine.
SERVICES = {"brick1982": (True, [[("", "brick-panel-kiosk"), ("", "brick-panel"), ("--user", "brick-panel-deploy.timer")],
                                 [("", "lcars-kiosk"), ("--user", "lcars-deploy.timer")]]),
            "brick9000": (False, [[("--user", "brick-status")]])}


def status(url: str) -> int:
    req = urllib.request.Request(url, method="GET")
    try:
        return urllib.request.urlopen(req, timeout=10, context=ssl.create_default_context()).status
    except urllib.error.HTTPError as e:
        return e.code
    except OSError:
        return 0


def in_maintenance() -> set[str]:
    """Hosts in a maintenance window (bin/maintenance). None when Prometheus
    can't be asked (the laptop): then nothing is excused."""
    qs = urllib.parse.urlencode({"query": "brick_maintenance_until_seconds > time()"})
    try:
        with urllib.request.urlopen(f"{PROMETHEUS}/api/v1/query?{qs}", timeout=10) as r:
            return {m["metric"].get("node", "") for m in json.load(r)["data"]["result"]}
    except (OSError, ValueError, KeyError) as e:
        print(f"note: no maintenance windows ({e!r}); a host that's down fails", file=sys.stderr)
        return set()


def ssh(host: str, command: str) -> str:
    out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", f"zaphod@{host}", command],
                         capture_output=True, text=True)
    return out.stdout.strip()


def host_units(host: str, choices: list[list[tuple[str, str]]]) -> list[tuple[str, str, str]]:
    """(scope, unit, state) for the set of units the host runs: the first set
    all active, else the first whose first unit is (half up: what's down
    shows), else the first set."""
    found = [[(scope, unit, ssh(host, f"jenkins-gate is-active {scope} {unit}") or "unreachable")  # the gate splits on spaces
              for scope, unit in units] for units in choices]
    for units in found:
        if all(state == "active" for _, _, state in units):
            return units
    return next((units for units in found if units[0][2] == "active"), found[0])


def main() -> int:
    problems, warnings, resting = [], [], in_maintenance()
    for name, ok in NAMES.items():
        code = status(f"https://{name}.brick.nozdormu.cloud/")
        print(f"{'ok  ' if code in ok else 'DOWN'} {name}.brick.nozdormu.cloud ({code or 'no answer'})")
        if code not in ok:
            problems.append(name)
    for host, (needed, choices) in SERVICES.items():
        for scope, unit, state in host_units(host, choices):
            if state == "active":
                mark = "ok  "
            elif host in resting:  # in a maintenance window: reported, not failed
                mark = "mnt "
            else:
                mark = "DOWN" if needed else "warn"
                (problems if needed else warnings).append(f"{host}/{unit}")
            print(f"{mark} {host} {unit} ({state})")
    # The board's data: brick-status's own state, read on brick9000 (it only
    # listens on localhost there).
    try:
        age = time.time() - json.loads(ssh("brick9000", "jenkins-gate board-state")).get("updated", 0)
    except ValueError:
        age = float("inf")
    print(f"{'ok  ' if age < 60 else 'warn'} brick9000 board data ({'unreachable' if age == float('inf') else f'{age:.0f}s old'})")
    if age >= 60:
        warnings.append("board data")
    if warnings:
        print(f"\nbrick9000 (optional): {', '.join(warnings)}")
    print(f"\n{'all up' if not problems else 'problems: ' + ', '.join(problems)}")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
