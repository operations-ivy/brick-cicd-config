#!/bin/sh
# Seal the brick-jenkins Secret for the cluster's Jenkins, from the laptop,
# into brick-k8s-secrets (private) at jenkins/brick-jenkins-sealedsecret.yaml.
# Then apply that file (README, "Jenkins").
#
# The values are the ones brick9000's Jenkins used, kept in
# ~/.config/brick-jenkins/secrets on brick9000, so webhook URLs, brick-status'
# login and the SSH key every host trusts all carry on unchanged. Docker Hub's
# username and access token come from brick9000's `docker login`. Nothing is
# printed; plaintext only exists in a private temporary directory until exit.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
k8s_config=${BRICK_K8S_CONFIG:-$HOME/code/brick-k8s-config}
out=${1:-$HOME/code/brick-k8s-secrets/jenkins/brick-jenkins-sealedsecret.yaml}
brick9000=${BRICK9000:-zaphod@192.168.1.221}

umask 077
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fetch() {  # <file on brick9000> <key>
    ssh -o BatchMode=yes "$brick9000" cat ".config/brick-jenkins/secrets/$1" >"$tmp/$2"
    [ -s "$tmp/$2" ] || { echo "seal-secrets: $1 is empty on brick9000" >&2; exit 1; }
}
fetch admin_password admin-password
fetch brick_status_password brick-status-password
fetch webhook_secret webhook-secret
fetch ssh_key ssh-key

ssh -o BatchMode=yes "$brick9000" cat .docker/config.json | python3 -c '
import base64, json, sys
auth = json.load(sys.stdin)["auths"]["https://index.docker.io/v1/"]["auth"]
user, token = base64.b64decode(auth).decode().split(":", 1)
open(sys.argv[1], "w").write(user)
open(sys.argv[2], "w").write(token)
' "$tmp/dockerhub-username" "$tmp/dockerhub-token"

mkdir -p "$(dirname "$out")"
(cd "$tmp" && kubectl create secret generic brick-jenkins --namespace jenkins --dry-run=client -o yaml \
    --from-file=admin-password --from-file=brick-status-password --from-file=webhook-secret \
    --from-file=ssh-key --from-file=dockerhub-username --from-file=dockerhub-token) \
    | kubeseal --cert "$k8s_config/secrets/sealed-secrets-public-cert.pem" --format yaml >"$out.tmp"
mv "$out.tmp" "$out"
echo "Sealed into $out; apply it with: kubectl apply -f $out"
