#!/bin/sh
# Seal the brick-jenkins Secret for the cluster's Jenkins, from the laptop,
# into brick-k8s-secrets (private) at jenkins/brick-jenkins-sealedsecret.yaml.
# Then apply that file (README, "Jenkins").
#
#   jenkins/seal-secrets            seal from the plaintext folder (below)
#   jenkins/seal-secrets --export   write the plaintext folder from the live
#                                   cluster Secret (to rebuild it, or to put
#                                   the values in KeePass: scripts/keepass-import
#                                   in homelab-context)
#
# The plaintext lives in a private folder on the laptop,
# ~/.config/brick-jenkins/secrets (BRICK_JENKINS_SECRETS), one file per value:
# admin_password, brick_status_password, webhook_secret, ssh_key (the key
# every host trusts) and optionally dockerhub_token. Until 2026-10-17 the only
# copy was on brick9000; its hardware failed, so it's the laptop and KeePass
# now. Nothing is printed.
#
# Docker Hub tag deletes (prune-images with APPLY=true) need an access token
# with delete scope, never the account password: put one in dockerhub_token
# and rerun this. Without it, prune-images still prunes the nodes, and only
# lists what it would delete on Docker Hub.
set -eu
k8s_config=${BRICK_K8S_CONFIG:-$HOME/code/brick-k8s-config}
src=${BRICK_JENKINS_SECRETS:-$HOME/.config/brick-jenkins/secrets}
umask 077

if [ "${1:-}" = --export ]; then
    mkdir -p "$src"
    for pair in admin_password:admin-password brick_status_password:brick-status-password \
        webhook_secret:webhook-secret ssh_key:ssh-key dockerhub_token:dockerhub-token; do
        file=${pair%%:*} key=${pair#*:}
        kubectl -n jenkins get secret brick-jenkins -o go-template="{{index .data \"$key\"}}" | base64 -d >"$src/$file.tmp"
        if [ -s "$src/$file.tmp" ]; then mv "$src/$file.tmp" "$src/$file"; else rm -f "$src/$file.tmp"; fi
    done
    echo "Wrote the live brick-jenkins values to $src (mode 600, not printed)"
    exit 0
fi

out=${1:-$HOME/code/brick-k8s-secrets/jenkins/brick-jenkins-sealedsecret.yaml}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

take() {  # <file in $src> <key>
    [ -s "$src/$1" ] || { echo "seal-secrets: $src/$1 is missing or empty (jenkins/seal-secrets --export rebuilds it)" >&2; exit 1; }
    cp "$src/$1" "$tmp/$2"
}
take admin_password admin-password
take brick_status_password brick-status-password
take webhook_secret webhook-secret
take ssh_key ssh-key

hub=
if [ -s "$src/dockerhub_token" ]; then
    take dockerhub_token dockerhub-token
    printf whitepatrick >"$tmp/dockerhub-username"
    hub="--from-file=dockerhub-username --from-file=dockerhub-token"
else
    echo "seal-secrets: no dockerhub_token in $src; sealing without Docker Hub credentials" >&2
fi

mkdir -p "$(dirname "$out")"
(cd "$tmp" && kubectl create secret generic brick-jenkins --namespace jenkins --dry-run=client -o yaml \
    --from-file=admin-password --from-file=brick-status-password --from-file=webhook-secret \
    --from-file=ssh-key $hub) \
    | kubeseal --cert "$k8s_config/secrets/sealed-secrets-public-cert.pem" --format yaml >"$out.tmp"
mv "$out.tmp" "$out"
echo "Sealed into $out; apply it with: kubectl apply -f $out"
